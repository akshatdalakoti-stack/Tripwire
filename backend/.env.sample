# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional: tried once if the primary model is overloaded / rate limited
GEMINI_FALLBACK_MODEL=
# Run with no API key at all (deterministic offline model, for demos / CI)
MOCK_LLM=0

# MongoDB Atlas (or local)
MONGO_URI=mongodb://localhost:27017/tripwire
DB_NAME=tripwire

# Redis (optional — the app runs fine without it)
REDIS_URL=redis://localhost:6379

# Execution tuning
MAX_CONCURRENT_RUNS=4        # scenarios executed at once
LLM_MAX_CONCURRENCY=6        # simultaneous LLM requests, process-wide
LLM_MAX_RETRIES=3            # retries with backoff on 429 / 5xx
MAX_TRIALS=20
CLASSIFY_PASSES=1            # LLM double-checks passing runs for goal drift
GUARDRAIL_LLM_JUDGE=1        # one batched LLM call grades guardrail responses

# App
APP_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com
